#!/usr/bin/env bash
# Lanzador de la libreria de calculo de auditoria-nia-es.
#
# Se anade automaticamente al PATH del Bash mientras el plugin esta activo, de
# modo que las skills invocan simplemente:
#
#     audita ingesta 00-fuentes/sumas_y_saldos.xlsx --encargo .
#
# sin exportar PYTHONPATH ni conocer donde ha instalado Claude Code el plugin.
set -euo pipefail

# --- localizar la raiz del plugin ------------------------------------------
# Se resuelve desde la propia ubicacion del script, no desde el directorio de
# trabajo: tras instalar, el plugin vive en una cache y el cwd es el del cliente.
origen="${BASH_SOURCE[0]}"
while [ -L "$origen" ]; do
  destino="$(readlink "$origen")"
  case "$destino" in
    /*) origen="$destino" ;;
    *)  origen="$(cd -P "$(dirname "$origen")" && pwd)/$destino" ;;
  esac
done
RAIZ="$(cd -P "$(dirname "$origen")/.." && pwd)"

# --- interprete de Python ---------------------------------------------------
PY=""
for cand in python3 python py; do
  if command -v "$cand" >/dev/null 2>&1; then
    if "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
      PY="$cand"; break
    fi
  fi
done
if [ -z "$PY" ]; then
  cat >&2 <<'FIN'
ERROR: no se ha encontrado Python 3.10 o superior.

auditoria-nia-es necesita Python para ejecutar los calculos. El modelo interpreta y
redacta, pero los cuadres, recalculos y extrapolaciones los hace el script: sin
Python el plugin no puede producir un papel de trabajo.

  Windows : https://www.python.org/downloads/  (marque "Add python.exe to PATH")
  macOS   : brew install python
  Linux   : sudo apt install python3
FIN
  exit 127
fi

# --- dependencias -----------------------------------------------------------
if ! "$PY" -c 'import pandas, openpyxl' 2>/dev/null; then
  faltan=""
  "$PY" -c 'import pandas'  2>/dev/null || faltan="$faltan pandas"
  "$PY" -c 'import openpyxl' 2>/dev/null || faltan="$faltan openpyxl"
  cat >&2 <<FIN
ERROR: faltan dependencias de Python:$faltan

Instalelas con:

  $PY -m pip install pandas openpyxl

Son las dos unicas que necesita el plugin.
FIN
  exit 127
fi

export PYTHONPATH="$RAIZ/shared/scripts${PYTHONPATH:+:$PYTHONPATH}"
export AUDITA_RAIZ="$RAIZ"
exec "$PY" -m audita.cli "$@"
